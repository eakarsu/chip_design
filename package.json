{
  "name": "ai-chip-design-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/run-compatible-node.sh node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "./scripts/run-compatible-node.sh node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "lint:governed": "eslint src/lib/eda src/lib/commercial app/api/eda app/api/workspace scripts __tests__/eda --max-warnings=0",
    "lint:all": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "cli": "tsx bin/chip-design.ts",
    "eda:worker": "tsx scripts/eda-worker.ts",
    "eda:golden": "tsx scripts/verify-golden.ts",
    "check:production": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=react-server\" tsx scripts/check-production.ts",
    "migrate": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=react-server\" ./scripts/run-compatible-node.sh node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "create-admin": "./scripts/run-compatible-node.sh node_modules/tsx/dist/cli.mjs scripts/create-admin.ts",
    "backup:eda": "tsx scripts/eda-backup.ts",
    "restore:verify": "tsx scripts/verify-restore.ts",
    "audit:production": "tsx scripts/audit-production-routes.ts"
  },
  "bin": {
    "chip-design": "bin/chip-design.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.0.0",
    "@mui/material-nextjs": "^9.1.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/pg": "^8.20.4",
    "@types/three": "^0.180.0",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "next": "^16.2.10",
    "next-mdx-remote": "^6.0.0",
    "openai": "^6.5.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.10",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "three": "^0.180.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "^0.25.12 || ^0.28.1"
  }
}
