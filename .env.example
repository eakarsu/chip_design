# OpenRouter AI API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHIP_REVIEW_MODEL=anthropic/claude-sonnet-4.5
# Optional faster model for the interactive button. It must satisfy the same
# zero-data-retention policy or the request will be rejected.
# OPENROUTER_CHIP_REVIEW_INTERACTIVE_MODEL=approved-zdr-model-slug
# Interactive reviews use one specialist pass by default. Enable only when the
# additional latency and provider cost of a blocking challenger pass are acceptable.
OPENROUTER_CHIP_REVIEW_TWO_PASS=false
# Optional explicit reasoning budget. Zero keeps interactive reviews responsive.
OPENROUTER_CHIP_REVIEW_REASONING_TOKENS=0
OPENROUTER_CHIP_REVIEW_TIMEOUT_MS=60000
# Optional independent challenger model; defaults to the specialist model.
# OPENROUTER_CHIP_REVIEW_CRITIC_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_RETRIES=2
# Governed chat preserves OPENROUTER_MODEL as its specialist, then falls back
# under the same ZDR policy when that provider stalls or returns incomplete JSON.
OPENROUTER_COPILOT_PRIMARY_TIMEOUT_MS=45000
OPENROUTER_COPILOT_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_COPILOT_FALLBACK_TIMEOUT_MS=75000
# Confidential design reviews require ZDR and deny provider data collection by default.
OPENROUTER_REQUIRE_ZDR=true
OPENROUTER_ALLOW_DATA_COLLECTION=false

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://neuralchip.ai

# CORS Configuration (comma-separated origins, or '*' for all)
ALLOWED_ORIGINS=https://neuralchip.ai,http://localhost:3000

# Environment
NODE_ENV=development

# Governed EDA service (production values must use absolute durable paths)
CHIP_DB_PATH=./data/chip_design.db
CHIP_EDA_OBJECT_DIR=./data/eda-objects
CHIP_BACKUP_DIR=./data/backups
CHIP_ALLOW_DEMO_SEED=false

# Production OIDC — the value is a kid -> base64-encoded PEM public-key ring
CHIP_OIDC_ISSUER=https://identity.example.com
CHIP_OIDC_AUDIENCE=chip-design
CHIP_OIDC_PUBLIC_KEYS_JSON={"current":"BASE64_ENCODED_PEM_PUBLIC_KEY"}
# Optional first-party browser-session exchange. Generate an independent RSA
# keypair; keep only the public half in CHIP_OIDC_PUBLIC_KEYS_JSON and keep the
# base64 PKCS#8 private key exclusively in the deployment secret store.
CHIP_OIDC_INTERNAL_KEY_ID=browser-exchange-current
CHIP_OIDC_INTERNAL_PRIVATE_KEY_BASE64=BASE64_ENCODED_PKCS8_PRIVATE_KEY
CHIP_OIDC_INTERNAL_TOKEN_SECONDS=600

# Organization-approved, immutable tool images (examples are non-runnable)
CHIP_YOSYS_IMAGE=openroad/orfs@sha256:eae643bb3ae0c6facc88fabee0e08760932504bedc3a719326536025183c5bd2
CHIP_OPENROAD_IMAGE=openroad/orfs@sha256:eae643bb3ae0c6facc88fabee0e08760932504bedc3a719326536025183c5bd2
CHIP_YOSYS_BINARY=yosys
CHIP_OPENROAD_BINARY=/OpenROAD-flow-scripts/tools/install/OpenROAD/bin/openroad
CHIP_EDA_MEMORY_LIMIT=4g
CHIP_EDA_CPU_LIMIT=2
CHIP_EDA_PIDS_LIMIT=512
CHIP_EDA_CONTAINER_USER=1001:1001
CHIP_MAX_JOB_INPUT_BYTES=26214400
CHIP_MAX_JOB_OUTPUT_BYTES=262144000

# Signed SCM webhook receivers. Configure only the providers connected from
# Engineering Operations; secrets belong in the deployment secret store.
# CHIP_GITHUB_WEBHOOK_SECRET=replace_with_a_high_entropy_secret
# CHIP_GITLAB_WEBHOOK_TOKEN=replace_with_a_high_entropy_token

# Commercial workspace database. PostgreSQL is selected when this is a
# postgresql:// URL; local development otherwise falls back to CHIP_DB_PATH.
CHIP_COMMERCIAL_DATABASE_URL=postgresql://chip_app:change_me@localhost:5432/chip_design
CHIP_COMMERCIAL_DB_POOL_SIZE=10
CHIP_COMMERCIAL_DB_SSL=disable
# Demo workspace records are local/test data. Production requires an explicit opt-in.
CHIP_ALLOW_COMMERCIAL_DEMO_SEED=false

# Commercial artifact storage. Production validation requires an encrypted S3
# bucket and a KMS key. Filesystem storage remains a development fallback.
CHIP_OBJECT_STORAGE_ROOT=./data/commercial-objects
# CHIP_OBJECT_STORAGE_BUCKET=chip-design-artifacts
# CHIP_OBJECT_STORAGE_REGION=us-east-1
# CHIP_OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# CHIP_OBJECT_STORAGE_FORCE_PATH_STYLE=false
# CHIP_OBJECT_STORAGE_KMS_KEY=alias/chip-design-artifacts
# CHIP_OBJECT_STORAGE_ACCESS_KEY=change_me
# CHIP_OBJECT_STORAGE_SECRET_KEY=change_me

# Capability execution adapters. Production preflight requires either the shared
# adapter pair or an action-specific URL/token pair for every enterprise action.
# Action-specific values such as CHIP_JIRA_SYNC_ADAPTER_URL/TOKEN override the
# shared pair. Production URLs must use HTTPS and all tokens/private keys belong
# in the deployment secret store.
# CHIP_ENTERPRISE_ADAPTER_URL=https://integrations.example.com/chip-capabilities
# CHIP_ENTERPRISE_ADAPTER_TOKEN=replace_with_a_high_entropy_token
# CHIP_SCM_STATUS_PUBLISH_ADAPTER_URL=https://integrations.example.com/scm-status
# CHIP_SCM_STATUS_PUBLISH_ADAPTER_TOKEN=replace_with_a_high_entropy_token
CHIP_RELEASE_SIGNING_PRIVATE_KEY_BASE64=BASE64_ENCODED_PKCS8_PRIVATE_KEY
CHIP_RELEASE_SIGNING_KEY_ID=tapeout-release-current

# Local-only demo autofill; keep real values in the ignored .env file.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
